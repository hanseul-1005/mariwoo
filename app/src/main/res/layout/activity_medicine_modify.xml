<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".basic.activity.MedicineModifyActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/base_background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medicineModifyActivity_layout_top"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/top_color"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/medicineModifyActivity_imageView_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginLeft="5dp"
                android:src="@drawable/icon_back"
                android:background="@color/top_color"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/top_menu_title"
                android:background="@color/top_color"
                android:text="약 수정" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/medicineModifyActivity_layout_top"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="20dp"
            android:background="@color/base_background">

            <LinearLayout
                android:id="@+id/signActivity_layout_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/base_background"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/icon_medicine"
                        android:background="@color/base_background"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="약 이름"
                        style="@style/sign_title"
                        android:background="@color/base_background"
                        android:layout_marginLeft="3dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/layout_border_radius5"
                    android:layout_marginTop="5dp">

                    <EditText
                        android:id="@+id/medicineModifyActivity_editText_id"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/loginActivity_editText_info"
                        android:hint="약이름을 입력하세요"
                        android:text="고혈압 약"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/signActivity_layout_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/signActivity_layout_name"
                android:background="@color/base_background"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/icon_calendar"
                        android:background="@color/base_background"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="반복 요일 선택"
                        style="@style/sign_title"
                        android:background="@color/base_background"
                        android:layout_marginLeft="3dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:layout_marginTop="5dp"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="월"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="화"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="수"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="목"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="금"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="토"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="일"
                        android:background="@drawable/button_shape_circle"
                        style="@style/add_day_btn"
                        android:layout_marginLeft="3dp"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/signActivity_layout_day"
                android:layout_marginTop="5dp"
                android:background="@color/base_background"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/icon_time"
                        android:background="@color/base_background"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="복용 시간 수정"
                        style="@style/sign_title"
                        android:background="@color/base_background"
                        android:layout_marginLeft="3dp"/>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_morning"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@drawable/layout_medicine_day_radius"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/morning"
                            android:background="@color/base_background"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="아침"
                            android:background="@color/base_background"
                            style="@style/medicine_day"
                            android:layout_marginLeft="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/medicineModifyActivity_layout_morning"
                        app:layout_constraintEnd_toStartOf="@id/medicineModifyActivity_layout_morning_add"
                        android:background="@color/base_background"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_medicine_time_radius"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="식전"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_bottom_stroke"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="07:00"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_morning_add"
                        android:layout_width="50dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/layout_medicine_add_radius"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/icon_add_white"
                            android:background="@color/theme_color"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_launch"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@drawable/layout_medicine_day_radius"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/launch"
                            android:background="@color/base_background"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="점심"
                            android:background="@color/base_background"
                            style="@style/medicine_day"
                            android:layout_marginLeft="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/medicineModifyActivity_layout_launch"
                        app:layout_constraintEnd_toStartOf="@id/medicineModifyActivity_layout_launch_add"
                        android:background="@color/base_background"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_medicine_time_radius"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="식후"
                                style="@style/medicine_day"/>


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_bottom_stroke"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13:00"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_launch_add"
                        android:layout_width="50dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/layout_medicine_add_radius"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/icon_add_white"
                            android:background="@color/theme_color"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_dinner"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@drawable/layout_medicine_day_radius"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/dinner"
                            android:background="@color/base_background"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="저녁"
                            android:background="@color/base_background"
                            style="@style/medicine_day"
                            android:layout_marginLeft="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/medicineModifyActivity_layout_dinner"
                        app:layout_constraintEnd_toStartOf="@id/medicineModifyActivity_layout_dinner_add"
                        android:background="@color/base_background"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_medicine_time_radius"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="식후"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_bottom_stroke"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="19:05"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_dinner_add"
                        android:layout_width="50dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/layout_medicine_add_radius"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/icon_add_white"
                            android:background="@color/theme_color"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/base_background"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_night"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:background="@drawable/layout_medicine_day_radius"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/bed"
                            android:background="@color/base_background"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="취침 전"
                            android:background="@color/base_background"
                            style="@style/medicine_day"
                            android:layout_marginLeft="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/medicineModifyActivity_layout_night"
                        app:layout_constraintEnd_toStartOf="@id/medicineModifyActivity_layout_night_add"
                        android:background="@color/base_background"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_medicine_time_radius"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="식전"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="41dp"
                            android:background="@drawable/layout_bottom_stroke"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="21:00"
                                style="@style/medicine_day"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/medicineModifyActivity_layout_night_add"
                        android:layout_width="50dp"
                        android:layout_height="80dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/layout_medicine_add_radius"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/icon_add_white"
                            android:background="@color/theme_color"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/medicineModifyActivity_button_login"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="수정"
                android:textColor="@color/theme_color"
                android:textSize="17dp"
                android:textStyle="bold"
                android:background="@drawable/layout_border_radius10"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>