<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".basic.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/main_layout"
        android:background="@color/login_background">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/loginActivity_layout_info"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:src="@drawable/img_logo"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loginActivity_layout_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            style="loginLayout_login"
            android:layout_marginBottom="50dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/loginActivity_layout_id"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/layout_border_radius10_bg_white">

                <EditText
                    android:id="@+id/loginActivity_editText_id"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="3dp"
                    style="@style/loginActivity_editText_info"
                    android:hint="아이디를 입력하세요"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@+id/loginActivity_editText_pw"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/loginActivity_layout_pw"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                app:layout_constraintTop_toBottomOf="@+id/loginActivity_layout_id"
                android:layout_marginTop="10dp"
                android:background="@drawable/layout_border_radius10_bg_white">

                <EditText
                    android:id="@+id/loginActivity_editText_pw"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="3dp"
                    style="@style/loginActivity_editText_info"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:hint="비밀번호를 입력하세요"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginActivity_button_login"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_radius15_bg_theme"
                android:text="로그인"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:layout_constraintTop_toBottomOf="@+id/loginActivity_layout_pw" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginActivity_button_sign"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_radius15_bg_white"
                android:text="회원가입"
                android:textColor="@color/theme_color"
                android:textSize="15dp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                app:layout_constraintTop_toBottomOf="@+id/loginActivity_button_login" />

            <com.navercorp.nid.oauth.view.NidOAuthLoginButton
                android:visibility="gone"
                android:id="@+id/naverLoginActivity_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintTop_toBottomOf="@id/loginActivity_button_sign"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/naverLoginActivity_button"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="5dp">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="카카오 로그인"
                    android:textColor="#1D1C00"
                    android:textStyle="bold"
                    app:backgroundTint="#FEE500"
                    app:icon="@drawable/icon_kakao"
                    app:iconPadding="0dp"
                    app:iconTint="@null"
                    app:iconSize="25dp"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="네이버 로그인"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    app:backgroundTint="#03C75A"
                    app:icon="@drawable/icon_naver"
                    app:iconPadding="0dp"
                    app:iconTint="@null"
                    app:iconSize="38dp"
                    app:cornerRadius="8dp"/>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>