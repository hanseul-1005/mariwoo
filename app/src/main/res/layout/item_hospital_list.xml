<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/layout_border_radius5"
    android:orientation="vertical"
    android:padding="15dp"
    android:layout_marginBottom="10dp">

    <!-- 1행: 아이콘 + 날짜 + 시간 + 병원명 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/icon_calendar"
            android:tint="@color/theme_color"/>

        <TextView
            android:id="@+id/itemHospitalList_textView_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/theme_color"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/itemHospitalList_textView_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/theme_color"
            android:textStyle="bold"
            android:layout_marginLeft="6dp"/>

        <TextView
            android:id="@+id/itemHospitalList_textView_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginLeft="8dp"
            android:ellipsize="end"
            android:maxLines="1"/>

    </LinearLayout>

    <!-- 2행: 비고 박스 -->
    <LinearLayout
        android:id="@+id/itemHospitalList_layout_memo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/itemHospitalList_textView_memo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:gravity="center_vertical"
            android:textSize="13sp"
            android:textColor="@color/color_gray5"/>

    </LinearLayout>

    <!-- 3행: 수정 / 삭제 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/itemHospitalList_button_modify"
            android:layout_width="70dp"
            android:layout_height="28dp"
            android:text="수정"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_radius10_bg_theme"
            android:stateListAnimator="@null"
            android:layout_marginRight="6dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/itemHospitalList_button_delete"
            android:layout_width="70dp"
            android:layout_height="28dp"
            android:text="삭제"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/button_radius10_red"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</LinearLayout>
