<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".basic.user.ChangeInfoActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/changeInfoActivity_layout_top"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/top_color"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/changeInfoActivity_imageView_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="5dp"
                android:src="@drawable/icon_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                style="@style/top_menu_title"
                android:text="내 정보 변경"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/changeInfoActivity_layout_top"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="20dp"
            android:background="@color/base_background">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/changeInfoActivity_layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/changeInfoActivity_layout_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/changeInfoActivity_textView_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        android:text="연락처"
                        style="@style/sign_title"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:background="@drawable/layout_border_radius5"
                        app:layout_constraintTop_toBottomOf="@+id/changeInfoActivity_textView_phone"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        android:layout_marginTop="5dp">

                        <EditText
                            android:id="@+id/changeInfoActivity_editText_tel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            style="@style/loginActivity_editText_info"
                            android:hint="연락처를 입력하세요"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/changeInfoActivity_layout_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/changeInfoActivity_layout_phone"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/changeInfoActivity_textView_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        android:text="이메일"
                        style="@style/sign_title"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:layout_constraintTop_toBottomOf="@+id/changeInfoActivity_textView_email"
                        app:layout_constraintRight_toRightOf="parent"
                        android:layout_marginTop="5dp"
                        android:weightSum="2.2"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:background="@drawable/layout_border_radius5"
                            android:layout_weight="0.8">

                            <EditText
                                android:id="@+id/changeInfoActivity_editText_email"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                style="@style/loginActivity_editText_info"
                                android:hint="이메일"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.2"
                            android:text=" &#64; "
                            android:textAlignment="center"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:background="@drawable/layout_border_radius5"
                            android:layout_weight="1.2">

                            <EditText
                                android:id="@+id/changeInfoActivity_editText_emailAddr"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                style="@style/loginActivity_editText_info"
                                android:hint="naver.com"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/changeInfoActivity_layout_birth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/changeInfoActivity_layout_email"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/changeInfoActivity_textView_birth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        android:text="생년월일"
                        style="@style/sign_title"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:layout_constraintTop_toBottomOf="@+id/changeInfoActivity_textView_birth"
                        app:layout_constraintRight_toRightOf="parent"
                        android:layout_marginTop="5dp"
                        android:weightSum="4.2"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:background="@drawable/layout_border_radius5"
                            android:layout_weight="1.4">

                            <EditText
                                android:id="@+id/changeInfoActivity_editText_birth_year"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                style="@style/loginActivity_editText_info"
                                android:hint="1994"
                                android:textAlignment="center"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="년"
                            android:textAlignment="center"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:background="@drawable/layout_border_radius5"
                            android:layout_weight="0.8">

                            <EditText
                                android:id="@+id/changeInfoActivity_editText_birth_month"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                style="@style/loginActivity_editText_info"
                                android:hint="10"
                                android:textAlignment="center"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="월"
                            android:textAlignment="center"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:background="@drawable/layout_border_radius5"
                            android:layout_weight="0.8">

                            <EditText
                                android:id="@+id/changeInfoActivity_editText_birth_day"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                style="@style/loginActivity_editText_info"
                                android:hint="5"
                                android:textAlignment="center"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.4"
                            android:text="일"
                            android:textAlignment="center"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/changeInfoActivity_button_sign"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="내 정보 변경"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:textStyle="bold"
                android:background="@drawable/button_radius15_bg_theme"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>