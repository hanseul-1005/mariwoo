<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:id="@+id/itemMedicineInner_layout_morning_time"
            android:layout_width="120dp"
            android:layout_height="49dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:background="@drawable/layout_medicine_day_radius"
            android:gravity="center">

            <ImageView
                android:id="@+id/itemMedicineInner_imageView_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/morning"/>

            <TextView
                android:id="@+id/itemMedicineInner_textView_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아침"
                style="@style/medicine_day"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="51dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/itemMedicineInner_layout_morning_time"
            app:layout_constraintEnd_toStartOf="@+id/itemMedicineInner_layout_morning_update"
            android:background="@drawable/layout_medicine_time_radius"
            android:gravity="center">

            <TextView
                android:id="@+id/itemMedicineInner_textView_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="식전 07:00"
                style="@style/medicine_day"
                android:textAlignment="center"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemMedicineInner_layout_morning_update"
            android:layout_width="60dp"
            android:layout_height="49dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/layout_medicine_check_radius"
            android:gravity="center">

            <TextView
                android:id="@+id/itemMedicineInner_textView_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수정"
                style="@style/medicine_meal"/>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>