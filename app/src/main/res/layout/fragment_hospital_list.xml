<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/main_layout"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingBottom="0dp">

        <!-- 날짜 범위 + 등록 버튼 -->
        <LinearLayout
            android:id="@+id/hospitalListFragment_layout_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/hospitalListFragment_editText_startDate"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="@drawable/layout_border_radius5"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textSize="13sp"
                android:focusable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/hospitalListFragment_editText_endDate"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="@drawable/layout_border_radius5"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textSize="13sp"
                android:focusable="false"
                android:cursorVisible="false"
                android:inputType="none"
                android:gravity="center"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hospitalListFragment_button_add"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="등록"
                style="@style/add_btn"
                android:background="@drawable/button_radius15_bg_theme"
                android:layout_marginLeft="8dp"/>

        </LinearLayout>

        <!-- 목록 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/hospitalListFragment_layout_search"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/base_background">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hospitalListFragment_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingTop="5dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:id="@+id/hospitalListFragment_layout_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/icon_medicine"
                    android:alpha="0.3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="병원 스케줄이 없습니다"
                    android:textSize="15sp"
                    android:textColor="@color/color_gray5"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


