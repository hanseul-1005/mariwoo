<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/main_layout"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <!-- 검색 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hospitalListFragment_layout_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 날짜 범위 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/hospitalListFragment_button_search"
                android:layout_marginRight="8dp">

                <EditText
                    android:id="@+id/hospitalListFragment_editText_startDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/layout_border_radius5"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="13sp"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textSize="14sp"/>

                <EditText
                    android:id="@+id/hospitalListFragment_editText_endDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/layout_border_radius5"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:textSize="13sp"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:gravity="center"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hospitalListFragment_button_search"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="조회"
                style="@style/add_btn"
                android:background="@drawable/button_radius15_bg_theme"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/hospitalListFragment_button_add"
                android:layout_marginRight="6dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hospitalListFragment_button_add"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="등록"
                style="@style/add_btn"
                android:background="@drawable/button_radius15_bg_theme"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 목록 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/hospitalListFragment_layout_search"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/base_background"
            android:padding="5dp">

            <!-- 헤더 -->
            <LinearLayout
                android:id="@+id/hospitalListFragment_layout_title"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/layout_border_radius0"
                android:weightSum="4.72">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:gravity="center"
                    android:text="병원명"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0.01" android:background="@color/login_background"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="시간"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0.01" android:background="@color/login_background"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="비고"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="0.01" android:background="@color/login_background"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:gravity="center"
                    android:text=""
                    android:textSize="13sp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hospitalListFragment_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@+id/hospitalListFragment_layout_title"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:id="@+id/hospitalListFragment_layout_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/icon_medicine"
                    android:alpha="0.3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="병원 스케줄이 없습니다"
                    android:textSize="15sp"
                    android:textColor="@color/color_gray5"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
