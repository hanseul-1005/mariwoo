<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".basic.ui.medicineList.MedicineListFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/main_layout"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/medicineListFragment_layout_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_gravity="center_vertical"
                android:padding="2dp"
                android:background="@drawable/layout_border_radius5">

                <Spinner
                    android:id="@+id/medicineListFragment_spinner_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_margin="1dp"
                    android:layout_gravity="center_vertical"/>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/medicineListFragment_button_add"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="약등록"
                style="@style/add_btn"
                android:background="@drawable/button_radius15_bg_theme"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/medicineListFragment_layout_search"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/base_background"
            android:padding="5dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/medicineListFragment_recyclerview_outer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>