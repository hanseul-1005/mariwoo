<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_marginTop="5dp">

    <!-- 아침/점심/저녁/취침 전 -->
    <LinearLayout
        android:id="@+id/item_schedule_layout_time_type"
        android:layout_width="120dp"
        android:layout_height="49dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="@drawable/layout_medicine_day_radius"
        android:gravity="center">

        <ImageView
            android:id="@+id/item_schedule_image_time_type"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/morning"/>

        <TextView
            android:id="@+id/item_schedule_text_time_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아침"
            style="@style/medicine_day"
            android:layout_marginLeft="10dp"/>

    </LinearLayout>

    <!-- 식전/식후 + 시간 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="51dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_schedule_layout_time_type"
        app:layout_constraintEnd_toStartOf="@+id/item_schedule_layout_check"
        android:background="@drawable/layout_medicine_time_radius"
        android:gravity="center">

        <TextView
            android:id="@+id/item_schedule_text_time"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="식전 07:00"
            style="@style/medicine_day"
            android:textAlignment="center"
            android:gravity="center"/>

    </LinearLayout>

    <!-- 먹음/안먹음 버튼 -->
    <LinearLayout
        android:id="@+id/item_schedule_layout_check"
        android:layout_width="60dp"
        android:layout_height="49dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/layout_medicine_check_n_radius"
        android:gravity="center">

        <TextView
            android:id="@+id/item_schedule_text_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안먹음"
            style="@style/medicine_meal"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>