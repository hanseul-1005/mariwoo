<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Mariwoo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/mariwoo_theme</item>
        <item name="colorPrimaryVariant">@color/mariwoo_theme</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/mariwoo_theme</item>
        <!-- Customize your theme here. -->


        <!-- 상단 타이틀바 제거 -->
        <item name="windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/mariwoo_theme</item>


    </style>

    <style name="Theme.Mariwoo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Mariwoo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Mariwoo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>